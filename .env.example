# Copy this file to .env and fill in real values.
# Never commit .env — it's gitignored.

# ─── Server ──────────────────────────────────────────────────────────────────

# Port Express listens on (default 5000)
PORT=5000

# SQLite file path (default ./motosaic.db). On Render, set to /data/motosaic.db
DB_PATH=./motosaic.db

# Directory for uploaded client documents (default ./uploads). On Render, /data/uploads
UPLOADS_DIR=./uploads

# Node environment — "development" or "production"
NODE_ENV=development

# ─── Google Drive / Sheets / Gmail ───────────────────────────────────────────
# Single OAuth refresh-token flow drives Drive sync, Minerva sheet sync, and
# the questionnaire-complete email. Leave blank to disable those features
# (the server boots fine without them and just logs a warning).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Email recipient for questionnaire-complete notifications
NOTIFY_EMAIL=mike@motosaic.com

# Email "from" address (defaults to NOTIFY_EMAIL if unset)
NOTIFY_FROM_EMAIL=

# Path where the Minerva sheet URL is cached on disk
MINERVA_SHEET_URL_FILE=./minerva-sheet-url.txt

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Required only for the admin Claude chat panel
ANTHROPIC_API_KEY=

# Daily spend caps for the chat panel (admin auth doesn't prevent a leaked
# password from running up the bill — these do). Defaults are 200 req / 1M tok.
# ANTHROPIC_DAILY_REQUEST_LIMIT=200
# ANTHROPIC_DAILY_TOKEN_LIMIT=1000000

# ─── Supabase intelligence integration ───────────────────────────────────────
# Anon JWT for the client-profile-query edge function. Falls back to a hardcoded
# default if unset (the JWT is public-anon by design, but env-var indirection
# means you can rotate without a code change).
# SUPABASE_ANON_JWT=
# SUPABASE_PROFILE_URL=https://onkpufezwbrkuqbqfele.supabase.co/functions/v1/client-profile-query

# ─── Sentry (optional, error monitoring) ─────────────────────────────────────
# Sign up at https://sentry.io → create a Node.js project → paste the DSN here.
# Without it, Sentry init silently no-ops.
# SENTRY_DSN=

# ─── Inbound API protection (legacy) ─────────────────────────────────────────
# Optional shared secret for the public POST /api/clients endpoint.
# NOTE: existing check has a known bug — it fails open when header is absent.
# Slated for fix in Phase 2.
PORTAL_API_SECRET=

# ─── Admin auth ──────────────────────────────────────────────────────────────
# Password for the single admin user (Mike). No username — password-only.
# Required for /admin to work. Server returns 500 on login if unset.
ADMIN_PASSWORD=

# Random string used to sign session cookies. REQUIRED in production —
# the server refuses to boot without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In dev, falls back to an insecure default if unset.
SESSION_SECRET=

# ─── Zoom transcript ingestion ───────────────────────────────────────────────
# Webhook flow: Zoom posts to /api/zoom/webhook on recording.transcript_completed.
# The webhook payload includes a short-lived download_token that authorizes the
# transcript fetch, so we don't need Server-to-Server OAuth in v1 — only the
# Secret Token (for HMAC signature verification) is required to make the webhook
# work. The remaining ZOOM_* env vars are reserved for the planned phase-2
# backfill / list-recordings work that needs OAuth.

# Master switch. Set to "true" once the Zoom marketplace app is configured AND
# you've set ZOOM_WEBHOOK_SECRET_TOKEN. Until then, /api/zoom/webhook returns 503.
ZOOM_TRANSCRIPT_INGEST_ENABLED=false

# From Zoom Marketplace → your app → Event Subscriptions → Secret Token.
# Used to verify HMAC signatures on every incoming webhook delivery.
ZOOM_WEBHOOK_SECRET_TOKEN=

# From Zoom Marketplace → your app → App Credentials. Not used yet — reserved
# for the OAuth-based recording backfill work in phase 2.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ─── Client (Vite) ───────────────────────────────────────────────────────────
# Base URL for API calls from the React app.
# Leave empty for same-origin (recommended — Express serves the SPA).
# Set to e.g. https://portal.motosaic.com if you ever split frontend from backend.
VITE_API_BASE=
